# hadolint ignore=DL3006
FROM $AUTOWARE_BASE_IMAGE AS %PARTITION_NAME%
#ARG LIB_DIR
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG OCI_REVISION=""
ARG OCI_REF_NAME=""
ARG OCI_CREATED=""
ARG OCI_VERSION=""
LABEL org.opencontainers.image.source="https://github.com/OSS-TEST-GROUP/katech-autoware" \
      org.opencontainers.image.revision="${OCI_REVISION}" \
      org.opencontainers.image.ref.name="${OCI_REF_NAME}" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.version="${OCI_VERSION}"
ARG ROS_DISTRO
ARG SETUP_ARGS
ARG TARGETPLATFORM

# Set up runtime environment and artifacts
COPY --from=%PARTITION_NAME%-depend /rosdep-%PARTITION_NAME%-exec-depend-packages.txt /tmp/rosdep-%PARTITION_NAME%-exec-depend-packages.txt

# hadolint ignore=SC2002
RUN --mount=type=ssh \
  --mount=type=cache,target=/var/cache/apt,sharing=locked \
  ./setup-dev-env.sh -y --module all --no-nvidia --no-cuda-drivers --runtime openadkit \
  && pip uninstall -y ansible ansible-core \
  && apt-get update \
  && cat /tmp/rosdep-%PARTITION_NAME%-exec-depend-packages.txt | xargs apt-get install -y --no-install-recommends \
  && if [ "$TARGETPLATFORM" = "linux/amd64" ]; then \
      export LIB_DIR="x86_64"; \
     elif [ "$TARGETPLATFORM" = "linux/arm64" ]; then \
      export LIB_DIR="aarch64"; \
     fi \
  && echo "LIB_DIR ==============================is $LIB_DIR" \
  && /autoware/cleanup_system.sh $LIB_DIR $ROS_DISTRO

COPY --from=%PARTITION_NAME%-devel /opt/autoware /opt/autoware

# Copy bash aliases
COPY docker/etc/.bash_aliases /root/.bash_aliases
RUN echo "source /opt/autoware/setup.bash" > /etc/bash.bashrc

ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["/bin/bash"]


FROM $AUTOWARE_BASE_CUDA_IMAGE AS %PARTITION_NAME%-cuda
#ARG LIB_DIR
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG OCI_REVISION=""
ARG OCI_REF_NAME=""
ARG OCI_CREATED=""
ARG OCI_VERSION=""
LABEL org.opencontainers.image.source="https://github.com/OSS-TEST-GROUP/katech-autoware" \
      org.opencontainers.image.revision="${OCI_REVISION}" \
      org.opencontainers.image.ref.name="${OCI_REF_NAME}" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.version="${OCI_VERSION}"
ARG ROS_DISTRO
ARG TARGETPLATFORM
ARG INSTALL_CARLA_PYTHON_API=false
ARG CARLA_PYTHON_API_URL="https://github.com/gezp/carla_ros/releases/download/carla-0.9.15-ubuntu-22.04/carla-0.9.15-cp310-cp310-linux_x86_64.whl"
ARG CARLA_PYTHON_API_SHA256="d8766616df2511a58ac152ccc53e3307a84ccef9e7fb7108006667188d5766f8"

# Set up runtime environment and artifacts
COPY --from=%PARTITION_NAME%-depend /rosdep-%PARTITION_NAME%-exec-depend-packages.txt /tmp/rosdep-%PARTITION_NAME%-exec-depend-packages.txt

# hadolint ignore=SC2002
RUN --mount=type=ssh \
  --mount=type=cache,target=/var/cache/apt,sharing=locked \
  ./setup-dev-env.sh -y --module all --no-nvidia --no-cuda-drivers --runtime openadkit \
  && pip uninstall -y ansible ansible-core \
  && apt-get update \
  && cat /tmp/rosdep-%PARTITION_NAME%-exec-depend-packages.txt | xargs apt-get install -y --no-install-recommends \
  && if [ "$TARGETPLATFORM" = "linux/amd64" ]; then \
      export LIB_DIR="x86_64"; \
     elif [ "$TARGETPLATFORM" = "linux/arm64" ]; then \
      export LIB_DIR="aarch64"; \
     fi \
  && echo "LIB_DIR =============================is $LIB_DIR" \
  && /autoware/cleanup_system.sh $LIB_DIR $ROS_DISTRO

# The CARLA 0.9.15 client wheel is built for Ubuntu 22.04 / Python 3.10 / amd64.
# Install it only in the dedicated CARLA perception image and verify the exact
# artifact before pip sees it.
RUN set -e; if [ "$INSTALL_CARLA_PYTHON_API" = "true" ]; then \
      [ "$TARGETPLATFORM" = "linux/amd64" ] || { \
        echo "CARLA Python API only supports linux/amd64 in this release" >&2; \
        exit 1; \
      }; \
      curl -fL "$CARLA_PYTHON_API_URL" -o /tmp/carla-0.9.15-cp310-cp310-linux_x86_64.whl; \
      echo "$CARLA_PYTHON_API_SHA256  /tmp/carla-0.9.15-cp310-cp310-linux_x86_64.whl" | sha256sum -c -; \
      python3 -m pip install --no-cache-dir /tmp/carla-0.9.15-cp310-cp310-linux_x86_64.whl transforms3d; \
      rm -f /tmp/carla-0.9.15-cp310-cp310-linux_x86_64.whl; \
    fi

COPY --from=%PARTITION_NAME%-devel-cuda /opt/autoware /opt/autoware

# Copy bash aliases
COPY docker/etc/.bash_aliases /root/.bash_aliases
RUN echo "source /opt/autoware/setup.bash" > /etc/bash.bashrc

ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["/bin/bash"]
